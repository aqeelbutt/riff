{
  "name": "riff",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "web": "pnpm --filter @riff/web",
    "backend:test": "cd apps/backend && ./run_tests.sh",
    "backend:migrate": "cd apps/backend && uv run --offline alembic upgrade head"
  },
  "devDependencies": { "turbo": "^2.5.0" }
}
