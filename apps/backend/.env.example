# Riff backend — copy to .env. Every Settings field lives here with its default.
APP_ENV=development                # development | test | production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://riff:riff_dev@localhost:5433/riff   # docker-compose maps Postgres to 5433

# Music engine
MUSIC_PROVIDER=acestep             # acestep (local sidecar) | fake (instant silent takes — tests/dev without the engine)
ENGINE_URL=http://127.0.0.1:8001   # scripts/engine.sh start
ENGINE_TIMEOUT_S=900
ENGINE_DEFAULT_MODEL=acestep-v15-turbo
ENGINE_STUDIO_MODEL=acestep-v15-sft

MEDIA_ROOT=../../var/media          # rendered audio (LocalFS). Relative paths resolve from apps/backend.

# Jobs (one GPU lane)
WORKER_ENABLED=true                # in-process worker; tests run with false and drive jobs by hand
JOB_POLL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3
JOB_STALE_SECONDS=300              # no heartbeat for this long ⇒ the reaper re-queues the job

# Mastering (ffmpeg loudnorm → -14 LUFS + MP3)
MASTERING_ENABLED=true
MASTERING_TARGET_LUFS=-14

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
